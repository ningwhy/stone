node_modules/
dist/
.DS_Store
.browser4-cli-state/
artifacts/**/*.png
.local-tools/
__pycache__/

.workbuddy/

# Matting intermediates are large and reproducible from art/source + the calibration file.
# Files already tracked stay tracked so past commits keep working; new ones are ignored.
art/matted/*.png
art/matted/*.webp
# The matting sidecars and the _backup folder are intermediates too: reproducible from
# art/source + art/calibration.json, so they must not accumulate in history either.
art/matted/*.json
art/matted/_backup/

# Rejected/archived generations stay on disk (zero-delete regen keeps every old take),
# but they are iteration leftovers, not sources of truth: only the current take ships.
# The current take may be the plain `-01.png` or the `_new.png` a --keep-old regen left,
# so both stay tracked; only the `_v{n}` archives are ignored.
art/cards/source/*_v[0-9]*.png
art/cards/source/_rejected-*/
art/cards/gen_*.log

# The `.bak` copies are what the matting pipeline saved before it re-cut a head:
# intermediates, reproducible from the source image plus the calibration file.
art/source/*.bak
art/matted/*.bak

# Scratch folders for generation runs. They hold the raw takes of the new cast and
# the card passes; the surviving take is copied into art/source and art/cards.
art/tmp_*/

# Playwright CLI session logs and the test runner's scratch output.
.playwright-cli/
test-results/

# Staging copies of chapter data kept while a chapter is being wired in.
artifacts/staging/
