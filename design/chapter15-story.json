          "hall_door",
          "hall"
        ]
      },
      {
        "type": "move",
        "actor": "baoyu",
        "via": [
          "hall",
          "gate"
        ]
      },
      {
        "type": "move",
        "actor": "qin_zhong",
        "via": [
          "gate",
          "court"
        ]
      }
    ]
  },
  {
    "chapter": "c15-shuiyue",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 殿上",
    "focus": "hall",
    "source": {
      "chapter": 15,
      "paragraphLead": "原来这铁槛寺原是宁荣二公当日修造",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-054",
    "speaker": "jing_xu",
    "text": "净虚道：「可是这几天都没工夫，因胡老爷府里产了公子，太太送了十两银子来这里，叫请几位师父念三日血盆经，忙的没个空儿，就没来请奶奶的安。」",
    "title": "念三日血盆经",
    "actions": [
      {
        "type": "effect",
        "actor": "jing_xu",
        "kind": "greet",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-shuiyue",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 殿上",
    "focus": "hall",
    "source": {
      "chapter": 15,
      "paragraphLead": "原来这铁槛寺原是宁荣二公当日修造",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-055",
    "speaker": "baoyu",
    "text": "且说秦钟、宝玉二人正在殿上顽耍，因见智能过来，宝玉笑道：「能儿来了。」秦钟道：「理那东西作什么？」宝玉笑道：「你别弄鬼，那一日在老太太屋里，一个人没有，你搂着他作什么？这会子还哄我。」秦钟笑道：「这可是没有的话。」",
    "title": "能儿来了",
    "actions": [
      {
        "type": "show",
        "actor": "zhi_neng",
        "at": "hall"
      },
      {
        "type": "move",
        "actor": "zhi_neng",
        "via": [
          "gate",
          "hall"
        ]
      },
      {
        "type": "effect",
        "actor": "baoyu",
        "kind": "greet",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-shuiyue",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 殿上",
    "focus": "hall",
    "source": {
      "chapter": 15,
      "paragraphLead": "原来这铁槛寺原是宁荣二公当日修造",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-056",
    "speaker": "baoyu",
    "text": "宝玉笑道：「有没有也不管你，你只叫住他倒碗茶来我吃，就丢开手。」秦钟笑道：「这又奇了，你叫他倒去，还怕他不倒？何必要我说呢。」宝玉道：「我叫他倒的是无情意的，不及你叫他倒的是有情意的。」秦钟只得说道：「能儿，倒碗茶来给我。」",
    "title": "不及你叫他倒的是有情意的",
    "actions": [
      {
        "type": "effect",
        "actor": "qin_zhong",
        "kind": "greet",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-shuiyue",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 殿上",
    "focus": "hall",
    "source": {
      "chapter": 15,
      "paragraphLead": "原来这铁槛寺原是宁荣二公当日修造",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-057",
    "speaker": "narrator",
    "text": "那智能儿自幼在荣府走动，无人不识，因常与宝玉秦钟顽笑。他如今大了，渐知风月，便看上了秦钟人物风流，那秦钟也极爱他妍媚，二人虽未上手，却已情投意合了。今智能见了秦钟，心眼俱开，走去倒了茶来。秦钟笑道：「给我。」宝玉叫：「给我！」智能儿抿嘴笑道：「一碗茶也争，我难道手里有蜜！」宝玉先抢得了，吃著，方要问话，只见智善来叫智能去摆茶碟子，一时来请他两个去吃茶果点心。他两个那里吃这些东西，坐一坐仍出来顽耍。",
    "title": "一碗茶也争",
    "actions": [
      {
        "type": "effect",
        "actor": "zhi_neng",
        "kind": "greet",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-petition",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 净室",
    "focus": "nun_seat",
    "source": {
      "chapter": 15,
      "paragraphLead": "凤姐也略坐片时，便回至净室歇息",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-060",
    "speaker": "narrator",
    "text": "凤姐也略坐片时，便回至净室歇息，老尼相送。此时众婆娘媳妇见无事，都陆续散了，自去歇息，跟前不过几个心腹常侍小婢，老尼便趁机说道：「我正有一事，要到府里求太太，先请奶奶一个示下。」",
    "title": "我正有一事，要到府里求太太",
    "actions": [
      {
        "type": "move",
        "actor": "feng",
        "via": [
          "hall",
          "court",
          "gate",
          "back_room"
        ]
      },
      {
        "type": "show",
        "actor": "jing_xu",
        "at": "back_room"
      }
    ]
  },
  {
    "chapter": "c15-petition",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 净室",
    "focus": "nun_seat",
    "source": {
      "chapter": 15,
      "paragraphLead": "凤姐也略坐片时，便回至净室歇息",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-061",
    "speaker": "jing_xu",
    "text": "老尼道：「阿弥陀佛！只因当日我先在长安县内善才庵内出家的时节，那时有个施主姓张，是大财主。他有个女儿小名金哥，那年都往我庙里来进香，不想遇见了长安府府太爷的小舅子李衙内。那李衙内一心看上，要娶金哥，打发人来求亲，不想金哥已受了原任长安守备的公子的聘定。",
    "title": "他有个女儿小名金哥",
    "actions": [
      {
        "type": "effect",
        "actor": "jing_xu",
        "kind": "greet",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-petition",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 净室",
    "focus": "nun_seat",
    "source": {
      "chapter": 15,
      "paragraphLead": "凤姐也略坐片时，便回至净室歇息",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-062",
    "speaker": "jing_xu",
    "text": "张家若退亲，又怕守备不依，因此说已有了人家。谁知李公子执意不依，定要娶他女儿，张家正无计策，两处为难。不想守备家听了此言，也不管青红皂白，便来作践辱骂，说一个女儿许几家，偏不许退定礼，就打官司告状起来。那张家急了，只得著人上京来寻门路，赌气偏要退定礼。",
    "title": "赌气偏要退定礼",
    "actions": [
      {
        "type": "effect",
        "actor": "jing_xu",
        "kind": "idle",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-petition",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 净室",
    "focus": "nun_seat",
    "source": {
      "chapter": 15,
      "paragraphLead": "凤姐也略坐片时，便回至净室歇息",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-063",
    "speaker": "jing_xu",
    "text": "老尼道：「我想如今长安节度云老爷与府上最契，可以求太太与老爷说声，打发一封书去，求云老爷和那守备说一声，不怕那守备不依。若是肯行，张家连倾家孝顺也都情愿。」",
    "title": "求云老爷和那守备说一声",
    "actions": [
      {
        "type": "effect",
        "actor": "jing_xu",
        "kind": "greet",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-petition",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 净室",
    "focus": "nun_seat",
    "source": {
      "chapter": 15,
      "paragraphLead": "凤姐也略坐片时，便回至净室歇息",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-064",
    "speaker": "feng",
    "text": "凤姐听了笑道：「这事倒不大，只是太太再不管这样的事。」老尼道：「太太不管，奶奶也可以主张了。」凤姐听说笑道：「我也不等银子使，也不做这样的事。」净虚听了，打去妄想，半晌叹道：「虽如此说，张家已知我来求府里，如今不管这事，张家不知道没工夫管这事，不希罕他的谢礼，倒象府里连这点子手段也没有的一般。」",
    "title": "我也不等银子使，也不做这样的事",
    "actions": [
      {
        "type": "effect",
        "actor": "feng",
        "kind": "anger",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-petition",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 净室",
    "focus": "nun_seat",
    "source": {
      "chapter": 15,
      "paragraphLead": "凤姐也略坐片时，便回至净室歇息",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-065",
    "speaker": "feng",
    "text": "凤姐听了这话，便发了兴头，说道：「你是素日知道我的，从来不信什么是阴司地狱报应的，凭是什么事，我说要行就行。你叫他拿三千银子来，我就替他出这口气。」老尼听说，喜不自禁，忙说：「有，有！这个不难。」",
    "title": "你叫他拿三千银子来",
    "actions": [
      {
        "type": "effect",
        "actor": "feng",
        "kind": "greet",
        "duration": 1.8
      }
    ]
  },
  {
    "chapter": "c15-petition",
    "scene": "c15_shuiyue",
    "place": "水月庵 · 净室",
    "focus": "nun_seat",
    "source": {
      "chapter": 15,
      "paragraphLead": "凤姐也略坐片时，便回至净室歇息",
      "textKind": "adaptation",
      "layer": "present"
    },
    "id": "C15-066",
    "speaker": "feng",
    "text": "凤姐又道：「我比不得他们扯篷拉牵的图银子。这三千银子，不过是给打发说去的小厮作盘缠，使他赚几个辛苦钱，我一个钱也不要他的。便是三万两，我此刻也拿的出来。」老尼连忙答应，又说道：「既如此，奶奶明日就开恩也罢了。」凤姐道：「你瞧瞧我忙的，那一处少了我？既应了你，自然快快的了结。」",
    "title": "我一个钱也不要他的",
    "actions": [
      {
        "type": "effect",
        "actor": "feng",
        "kind": "idle",
        "duration": 1.8
      }
    ]
