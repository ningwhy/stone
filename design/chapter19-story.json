   }
  ]
 },
 {
  "chapter": "c19-mingyan",
  "scene": "c5_ningfu",
  "place": "宁国府 · 二门外",
  "focus": "garden_entry",
  "source": {
   "chapter": 19,
   "paragraphLead": "茗烟嘻嘻笑道",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-016",
  "speaker": "baoyu",
  "text": "茗烟嘻嘻笑道：「这会子没人知道，我悄悄的引二爷往城外逛逛去，一会子再往这里来，他们就不知道了。」宝玉道：「不好，仔细花子拐了去。便是他们知道了，又闹大了，不如往熟近些的地方去。还可就来。」",
  "title": "不如往熟近些的地方去",
  "actions": [
   {
    "type": "effect",
    "actor": "baoyu",
    "kind": "greet",
    "duration": 1.0
   }
  ]
 },
 {
  "chapter": "c19-mingyan",
  "scene": "c5_ningfu",
  "place": "宁国府 · 二门外",
  "focus": "garden_entry",
  "source": {
   "chapter": 19,
   "paragraphLead": "茗烟道：“熟近地方",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-017",
  "speaker": "messenger",
  "text": "茗烟道：「熟近地方，谁家可去？这却难了。」宝玉笑道：「依我的主意，咱们竟找你花大姐姐去，瞧他在家作什么呢。」",
  "title": "咱们竟找你花大姐姐去",
  "actions": [
   {
    "type": "effect",
    "actor": "messenger",
    "kind": "greet",
    "duration": 1.2
   }
  ]
 },
 {
  "chapter": "c19-mingyan",
  "scene": "c5_ningfu",
  "place": "城外半里 · 途中",
  "focus": "garden_entry",
  "source": {
   "chapter": 19,
   "paragraphLead": "又道：“若他们知道了",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-018",
  "speaker": "narrator",
  "text": "又道：「若他们知道了，说我引著二爷胡走，要打我呢？」宝玉道：「有我呢。」茗烟听说，拉了马，二人从后门就走了。幸而袭人家不远，不过一半里路程，",
  "title": "二人从后门就走了",
  "actions": [
