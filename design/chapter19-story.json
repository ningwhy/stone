 },
 {
  "chapter": "c19-yusheng",
  "scene": "dinner",
  "place": "潇湘馆 · 里间",
  "focus": "grandmother_place",
  "source": {
   "chapter": 19,
   "paragraphLead": "宝玉总未听见这些话",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-073",
  "speaker": "narrator",
  "text": "宝玉总未听见这些话，只闻得一股幽香，却是从黛玉袖中发出，闻之令人醉魂酥骨。宝玉一把便将黛玉的袖子拉住，要瞧笼著何物。黛玉笑道：「冬寒十月，谁带什么香呢。」",
  "title": "只闻得一股幽香",
  "actions": [
