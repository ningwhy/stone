    "duration": 1.0
   }
  ]
 },
 {
  "chapter": "c19-liaolao",
  "scene": "night",
  "place": "怡红院 · 外间",
  "focus": "xiren_place",
  "source": {
   "chapter": 19,
   "paragraphLead": "李嬷嬷听了，又气又愧",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-040",
  "speaker": "nurse_li",
  "text": "李嬷嬷听了，又气又愧，便说道：「我不信他这样坏了。别说我吃了一碗牛奶，就是再比这个值钱的，也是应该的。难道待袭人比我还重？难道他不想想怎么长大了？我的血变的奶，吃的长这么大，如今我吃他一碗牛奶，他就生气了？我偏吃了，看怎么样！你们看袭人不知怎样，那是我手里调理出来的毛丫头，什么阿物儿！」",
  "title": "我的血变的奶",
  "actions": [
   {
    "type": "effect",
    "actor": "nurse_li",
    "kind": "rest",
    "duration": 1.4
   }
  ]
 },
