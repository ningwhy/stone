[
 {
  "chapter": "c19-ningfu",
  "scene": "c5_ningfu",
  "place": "宁国府 · 戏台",
  "focus": "garden_entry",
  "source": {
   "chapter": 19,
   "paragraphLead": "话说贾妃回宫",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-001",
  "speaker": "narrator",
  "text": "话说贾妃回宫，次日见驾谢恩，并回奏归省之事，龙颜甚悦。又发内帑彩缎金银等物，以赐贾政及各椒房等员，不必细说。且说荣宁二府中因连日用尽心力，真是人人力倦，各各神疲，又将园中一应陈设动用之物收拾了两三天方完。第一个凤姐事多任重，别人或可偷安躲静，独他是不能脱得的，二则本性要强，不肯落人褒贬，只扎挣著与无事的人一样。第一个宝玉是极无事最闲暇的。",
  "title": "荣宁二府人人力倦",
  "actions": [
   {
    "type": "show",
    "actor": "feng",
    "at": "garden_entry"
   }
  ]
 },
 {
  "chapter": "c19-ningfu",
  "scene": "c5_ningfu",
  "place": "宁国府 · 戏台",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "偏这日一早",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-002",
  "speaker": "narrator",
  "text": "偏这日一早，袭人的母亲又亲来回过贾母，接袭人家去吃年茶，晚间才得回来。因此，宝玉只和众丫头们掷骰子赶围棋作戏。正在房内顽的没兴头，忽见丫头们来回说：「东府珍大爷来请过去看戏，放花灯。」",
  "title": "袭人之母亲来接袭人家去吃年茶",
  "actions": [
   {
    "type": "show",
    "actor": "grandmother",
    "at": "upper_room"
   }
  ]
 },
 {
  "chapter": "c19-ningfu",
  "scene": "c5_ningfu",
  "place": "宁国府 · 戏台",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "才要去时",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-003",
  "speaker": "narrator",
  "text": "才要去时，忽又有贾妃赐出糖蒸酥酪来，宝玉想上次袭人喜吃此物，便命留与袭人了。",
  "title": "贾妃赐出糖蒸酥酪",
  "actions": [
   {
    "type": "effect",
    "actor": "baoyu",
    "kind": "jade",
    "duration": 1.2
   }
  ]
 },
 {
  "chapter": "c19-ningfu",
  "scene": "c5_ningfu",
  "place": "宁国府 · 戏台",
  "focus": "garden_center",
  "source": {
   "chapter": 19,
   "paragraphLead": "谁想贾珍这边唱的是",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-004",
  "speaker": "narrator",
  "text": "谁想贾珍这边唱的是《丁郎认父》，《黄伯央大摆阴魂阵》，更有《孙行者大闹天宫》，《姜子牙斩将封神》等类的戏文，倏尔神鬼乱出，忽又妖魔毕露，甚至于扬幡过会，号佛行香，锣鼓喊叫之声远闻巷外。",
  "title": "锣鼓喊叫之声远闻巷外",
  "actions": [
   {
    "type": "show",
    "actor": "baoyu",
    "at": "garden_center"
   }
  ]
 },
 {
  "chapter": "c19-ningfu",
  "scene": "c5_ningfu",
  "place": "宁国府 · 戏台",
  "focus": "garden_center",
  "source": {
   "chapter": 19,
   "paragraphLead": "满街之人个个都赞",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-005",
  "speaker": "narrator",
  "text": "满街之人个个都赞：「好热闹戏，别人家断不能有的。」",
  "title": "好热闹戏，别人家断不能有的",
  "actions": [
   {
    "type": "effect",
    "actor": "baoyu",
    "kind": "rest",
    "duration": 1.2
   }
  ]
 },
 {
  "chapter": "c19-ningfu",
  "scene": "c5_ningfu",
  "place": "宁国府 · 戏台",
  "focus": "upper_room_door",
  "source": {
   "chapter": 19,
   "paragraphLead": "宝玉见繁华热闹到如此不堪的田地",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-006",
  "speaker": "narrator",
  "text": "宝玉见繁华热闹到如此不堪的田地，只略坐了一坐，便走开各处闲耍。先是进内去和尤氏和丫鬟姬妾说笑了一回，便出二门来。尤氏等仍料他出来看戏，遂也不曾照管。贾珍，贾琏，薛蟠等只顾猜枚行令，百般作乐，也不理论，纵一时不见他在座，只道在里边去了，故也不问。至于跟宝玉的小厮们，那年纪大些的，知宝玉这一来了，必是晚间才散，因此偷空也有去会赌的，也有往亲友家去吃年茶的，更有或嫖或饮的，都私散了，",
  "title": "只略坐了一坐便走开各处闲耍",
  "actions": [
   {
    "type": "move",
    "actor": "baoyu",
    "via": [
     "garden_center",
     "upper_room_door"
    ]
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room_door",
  "source": {
   "chapter": 19,
   "paragraphLead": "宝玉见一个人没有",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-007",
  "speaker": "narrator",
  "text": "宝玉见一个人没有，因想」这里素日有个小书房，内曾挂著一轴美人，极画的得神。今日这般热闹，想那里自然无人，那美人也自然是寂寞的，须得我去望慰他一回。」",
  "title": "须得我去望慰他一回",
  "actions": [
   {
    "type": "move",
    "actor": "baoyu",
    "via": [
     "upper_room",
     "upper_room_door"
    ]
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room_door",
  "source": {
   "chapter": 19,
   "paragraphLead": "刚到窗前",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-008",
  "speaker": "narrator",
  "text": "刚到窗前，闻得房内有呻吟之韵。宝玉倒唬了一跳：敢是美人活了不成？",
  "title": "闻得房内有呻吟之韵",
  "actions": [
   {
    "type": "effect",
    "actor": "baoyu",
    "kind": "rest",
    "duration": 1.0
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "乃乍著胆子",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-009",
  "speaker": "narrator",
  "text": "乃乍著胆子，舔破窗纸，向内一看——那轴美人却不曾活，却是茗烟按著一个女孩子，也干那警幻所训之事。宝玉禁不住大叫：「了不得！」一脚踹进门去，将那两个唬开了，抖衣而颤。",
  "title": "那轴美人却不曾活",
  "actions": [
   {
    "type": "move",
    "actor": "baoyu",
    "via": [
     "upper_room_door",
     "upper_room"
    ]
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "茗烟见是宝玉",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-010",
  "speaker": "baoyu",
  "text": "茗烟见是宝玉，忙跪求不迭。宝玉道：「青天白日，这是怎么说。珍大爷知道，你是死是活？」",
  "title": "青天白日，这是怎么说",
  "actions": [
   {
    "type": "show",
    "actor": "messenger",
    "at": "upper_room"
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "一面看那丫头",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-011",
  "speaker": "narrator",
  "text": "一面看那丫头，虽不标致，倒还白净，些微亦有动人处，羞的脸红耳赤，低首无言。宝玉跺脚道：「还不快跑！」一语提醒了那丫头，飞也似去了。宝玉又赶出去，叫道：「你别怕，我是不告诉人的。」",
  "title": "还不快跑",
  "actions": [
   {
    "type": "effect",
    "actor": "baoyu",
    "kind": "greet",
    "duration": 1.2
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "急的茗烟在后叫",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-012",
  "speaker": "baoyu",
  "text": "急的茗烟在后叫：「祖宗，这是分明告诉人了！」宝玉因问：「那丫头十几岁了？」茗烟道：「大不过十六七岁了。」宝玉道：「连他的岁属也不问问，别的自然越发不知了。可见他白认得你了。可怜，可怜！」",
  "title": "连他的岁属也不问问",
  "actions": [
   {
    "type": "effect",
    "actor": "messenger",
    "kind": "rest",
    "duration": 1.0
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "又问：“名字叫什么",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-013",
  "speaker": "messenger",
  "text": "又问：「名字叫什么？」茗烟大笑道：「若说出名字来话长，真真新鲜奇文，竟是写不出来的。据他说，他母亲养他的时节做了个梦，梦见得了一匹锦，上面是五色富贵不断头卍字的花样，所以他的名字叫作卍儿。」",
  "title": "所以他的名字叫作卍儿",
  "actions": [
   {
    "type": "effect",
    "actor": "messenger",
    "kind": "greet",
    "duration": 1.2
   }
  ]
 },
 {
  "chapter": "c19-study",
  "scene": "c5_ningfu",
  "place": "宁国府 · 小书房",
  "focus": "upper_room",
  "source": {
   "chapter": 19,
   "paragraphLead": "宝玉听了笑道",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-014",
  "speaker": "narrator",
  "text": "宝玉听了笑道：「真也新奇，想必他将来有些造化。」说著，沉思一会。",
  "title": "想必他将来有些造化",
  "actions": [
   {
    "type": "effect",
    "actor": "baoyu",
    "kind": "rest",
    "duration": 1.2
   }
  ]
 },
 {
  "chapter": "c19-mingyan",
  "scene": "c5_ningfu",
  "place": "宁国府 · 二门外",
  "focus": "garden_entry",
  "source": {
   "chapter": 19,
   "paragraphLead": "茗烟因问",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-015",
  "speaker": "messenger",
  "text": "茗烟因问：「二爷为何不看这样的好戏？」宝玉道：「看了半日，怪烦的，出来逛逛，就遇见你们了。这会子作什么呢？」",
  "title": "二爷为何不看这样的好戏",
  "actions": [
   {
    "type": "show",
    "actor": "messenger",
    "at": "garden_entry"
   },
   {
    "type": "show",
    "actor": "baoyu",
