   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C19-024",
  "speaker": "messenger",
  "text": "茗烟撅了嘴道：「二爷骂著打著，叫我引了来，这会子推到我身上。我说别来罢，——不然我们还去罢。」",
  "title": "我说别来罢",
  "actions": [
   {
    "type": "effect",
    "actor": "messenger",
    "kind": "rest",
    "duration": 1.0
   }
  ]
 },
 {
  "chapter": "c19-xirenhome",
  "scene": "xiren_home",
  "place": "袭人家 · 里屋",
