        "type": "hide",
        "actor": "qin_zhong"
      }
    ]
  },
  {
    "chapter": "c16-return",
    "scene": "entry",
    "place": "荣国府 · 大门",
    "focus": "west_gate",
    "source": {
      "chapter": 16,
      "paragraphLead": "好容易盼至明日午错",
      "textKind": "adaptation",
      "layer": "present"
    },
