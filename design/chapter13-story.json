  ]
 },
 {
  "chapter": "c13-news",
  "scene": "c6_wangchui",
  "place": "凤姐院 · 房内",
  "focus": "feng_room",
  "source": {
   "chapter": 13,
   "paragraphLead": "凤姐闻听，吓了一身冷汗",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C13-013",
  "speaker": "narrator",
  "text": "彼时合家皆知，无不纳罕，都有些疑心。那长一辈的想他素日孝顺，平一辈的想他素日和睦亲密，下一辈的想他素日慈爱，以及家中仆从老小想他素日怜贫惜贱，慈老爱幼之恩，莫不悲嚎痛哭者。",
  "title": "无不纳罕",
  "actions": [],
  "offscreen": true
 },
 {
  "chapter": "c13-mourning",
  "scene": "night",
  "place": "贾母院 · 碧纱橱外间",
