 {
  "chapter": "c13-news",
  "scene": "c6_wangchui",
  "place": "凤姐院 · 房内",
  "focus": "feng_room",
  "source": {
   "chapter": 13,
   "paragraphLead": "凤姐闻听，吓了一身冷汗",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C13-012",
  "speaker": "narrator",
  "text": "凤姐闻听，吓了一身冷汗，出了一回神，只得忙忙的穿衣，往王夫人处来。",
  "title": "忙忙的穿衣",
  "actions": [
   {
    "type": "move",
    "actor": "feng",
    "via": [
     "feng_room",
     "hall"
    ]
