 {
  "chapter": "c12-visit",
  "scene": "c6_wangchui",
  "place": "凤姐院 · 房内",
  "focus": "feng_room",
  "source": {
   "chapter": 12,
   "paragraphLead": "话说凤姐正与平儿说话",
   "textKind": "adaptation",
