    "type": "effect",
    "actor": "qin_ke",
    "kind": "rest",
    "duration": 1.8
   }
  ]
 },
 {
  "chapter": "c11-winter",
  "scene": "c5_ningfu",
  "place": "秦氏卧房",
  "focus": "screen_bed",
  "source": {
   "chapter": 11,
   "paragraphLead": "且说贾瑞到荣府来了几次",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C11-065",
  "speaker": "narrator",
  "text": "凤姐儿到了尤氏上房坐下。尤氏道：“你冷眼瞧媳妇是怎么样？”凤姐儿低了半日头，说道：“这实在没法儿了。你也该将一应的后事用的东西给他料理料理，冲一冲也好。”",
  "title": "该料理后事了",
  "actions": [
