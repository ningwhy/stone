  ]
 },
 {
  "chapter": "c11-garden",
  "scene": "c5_ningfu",
  "place": "会芳园",
  "focus": "garden_center",
  "source": {
   "chapter": 11,
   "paragraphLead": "凤姐儿正自看园中的景致",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C11-044",
  "speaker": "jia_rui",
  "text": "贾瑞道：“也是合该我与嫂子有缘。我方才偷出了席，在这个清净地方略散一散，不想就遇见嫂子也从这里来。这不是有缘么？”一面说着，一面拿眼睛不住的觑着凤姐儿。",
  "title": "合该我与嫂子有缘",
  "actions": [
   {
    "type": "effect",
    "actor": "jia_rui",
    "kind": "idle",
    "duration": 1.8
   }
  ]
 },
 {
  "chapter": "c11-garden",
  "scene": "c5_ningfu",
  "place": "会芳园",
  "focus": "garden_center",
  "source": {
   "chapter": 11,
   "paragraphLead": "凤姐儿正自看园中的景致",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C11-045",
  "speaker": "feng",
  "text": "凤姐儿是个聪明人，见他这个光景，如何不猜透八九分呢，因向贾瑞假意含笑道：“怨不得你哥哥时常提你，说你很好。今日见了，听你说这几句话儿，就知道你是个聪明和气的人了。”",
  "title": "假意含笑",
  "actions": [
   {
    "type": "effect",
    "actor": "feng",
    "kind": "idle",
    "duration": 1.8
   }
  ]
 },
 {
  "chapter": "c11-garden",
  "scene": "c5_ningfu",
  "place": "会芳园",
  "focus": "garden_center",
  "source": {
   "chapter": 11,
   "paragraphLead": "凤姐儿正自看园中的景致",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C11-046",
  "speaker": "feng",
  "text": "（凤姐心里暗忖）这才是知人知面不知心呢，那里有这样禽兽的人呢。他如果如此，几时叫他死在我的手里，他才知道我的手段！",
  "title": "几时叫他死在我手里",
  "actions": [
   {
    "type": "effect",
    "actor": "feng",
    "kind": "anger",
    "duration": 1.8
   }
  ]
 },
