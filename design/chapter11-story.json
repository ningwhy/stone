  ]
 },
 {
  "chapter": "c11-winter",
  "scene": "c5_ningfu",
  "place": "秦氏卧房",
  "focus": "screen_bed",
  "source": {
   "chapter": 11,
   "paragraphLead": "且说贾瑞到荣府来了几次",
   "textKind": "adaptation",
   "layer": "present"
  },
  "id": "C11-064",
  "speaker": "qin_ke",
  "text": "秦氏说道：“好不好，春天就知道了。如今现过了冬至，又没怎么样，或者好的了也未可知。婶子回老太太、太太放心罢。”",
  "title": "春天就知道了",
  "actions": [
