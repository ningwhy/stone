    "place": "大观园 · 书房",
    "focus": "baoyu_greet",
    "source": {
      "chapter": 17,
      "paragraphLead": "贾政忽想起他来，方喝道：「你还不去",
      "textKind": "adaptation",
      "layer": "present"
